# Cloudflare Pages applies these automatically. See:
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'none'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Permissions-Policy: geolocation=(), camera=(), microphone=()

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/style.css
  Cache-Control: public, max-age=31536000, immutable

/screenshots/*
  Cache-Control: public, max-age=31536000, immutable

/brand/*
  Cache-Control: public, max-age=31536000, immutable

# Universal Links for the ClanTab iOS app (clantab-ios: "Custom domain +
# Universal Links"). Apple's swcd fetches this and requires application/json,
# HTTP 200, no redirect. Scoped to /g/* so only group invite links open the
# app; the marketing pages stay web.
/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: public, max-age=3600
/apple-app-site-association
  Content-Type: application/json
  Cache-Control: public, max-age=3600
